---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMarkets, getMarketBySlug } from '../../lib/wordpress';
import MuseumsAndCulturalContent from '../../components/markets/MuseumsAndCulturalContent.astro';
import CommercialRealEstateContent from '../../components/markets/CommercialRealEstateContent.astro';
import UniversitiesContent from '../../components/markets/UniversitiesContent.astro';
import CorporateContent from '../../components/markets/CorporateContent.astro';
import RetailContent from '../../components/markets/RetailContent.astro';
import ConstructionContent from '../../components/markets/ConstructionContent.astro';
import GenericMarketContent from '../../components/markets/GenericMarketContent.astro';

export async function getStaticPaths() {
  const markets = await getMarkets();
  return markets.map((market) => ({
    params: { slug: market.slug },
    props: { market },
  }));
}

const { slug } = Astro.params;
const { market: initialMarket } = Astro.props;
const market = (slug ? await getMarketBySlug(slug) : null) || initialMarket;

if (!market) {
  throw new Error(`Market not found: ${slug}`);
}
---

<BaseLayout seo={market.seo}>
  {slug === 'museums-and-cultural' && <MuseumsAndCulturalContent market={market} />}
  {slug === 'commercial-real-estate' && <CommercialRealEstateContent market={market} />}
  {slug === 'universities' && <UniversitiesContent market={market} />}
  {slug === 'corporate' && <CorporateContent market={market} />}
  {slug === 'retail' && <RetailContent market={market} />}
  {slug === 'construction' && <ConstructionContent market={market} />}
  {!['museums-and-cultural', 'commercial-real-estate', 'universities', 'corporate', 'retail', 'construction'].includes(slug || '') && (
    <GenericMarketContent market={market} />
  )}
</BaseLayout>

