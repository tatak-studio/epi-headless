---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getMarkets, getMarketBySlug, getProjects } from '../../lib/wordpress';
import '../../styles/markets-museums.css';

export async function getStaticPaths() {
  const markets = await getMarkets();
  return markets.map((market) => ({
    params: { slug: market.slug },
    props: { market },
  }));
}

const { slug } = Astro.params;
const { market: initialMarket } = Astro.props;
const market = (slug ? await getMarketBySlug(slug) : null) || initialMarket;

if (!market) {
  throw new Error(`Market not found: ${slug}`);
}

const title = typeof market.title === 'string' ? market.title : market.title.rendered;
const meta = market.meta_box || {};
const leadImg = meta.lead_image || '/hall-exhibit-display-mu12il5t-6a71.jpg';

const allProjects = await getProjects();
// Filter related projects in this market
const relatedProjects = allProjects.filter((p) => {
  const mkt = (p.meta_box.market || '').toLowerCase();
  const filterKey = (p.meta_box.filter_market || '').toLowerCase();
  const slugKey = market.slug.toLowerCase();
  return mkt.includes(slugKey.substring(0, 5)) || filterKey.includes(slugKey.substring(0, 4));
}).slice(0, 3);
---

<BaseLayout seo={market.seo}>
  <!-- Hero -->
  <section class="sig-hero" aria-labelledby="hero-title">
    <div class="sig-hero__media">
      <img src={leadImg} alt={title} style="width:100%;height:100%;object-fit:cover;display:block" />
    </div>
    <div class="sig-hero__scrim" aria-hidden="true"></div>
    <div class="epi-container sig-hero__inner">
      <nav aria-label="Breadcrumb">
        <ol class="sig-crumbs">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/markets">Markets</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      {meta.market_kicker && <p class="sig-kicker">{meta.market_kicker}</p>}
      <h1 class="epi-display-2 sig-hero__title" id="hero-title">
        {title} graphics and fabrication engineered for real-world conditions.
      </h1>
      <p class="sig-hero__lede">{meta.market_summary}</p>
      <div class="sig-hero__actions">
        <a class="epi-btn epi-btn--lg" href="#contact">Start Your Project</a>
        <a class="epi-btn epi-btn--lg epi-btn--outline-inverse" href="/projects">See Related Work</a>
      </div>
    </div>
    <div class="sig-hero__rule" aria-hidden="true"></div>
  </section>

  <!-- Market Overview & Delivery Strategy -->
  <section class="sig-section" aria-labelledby="strategy-title">
    <div class="epi-container sig-split">
      <div class="sig-split__copy">
        <h2 class="epi-h1" id="strategy-title">
          How we tailor production and install for {title}.
        </h2>
        <p>
          Every market presents unique site challenges, inspection criteria, and operational schedules. We coordinate directly with facilities directors, general contractors, and curators to ensure seamless installation without operational disruptions.
        </p>
        <div style="margin-top:var(--space-4);padding:var(--space-5);background:var(--paper-warm);border-radius:var(--radius-md)">
          <h3 class="epi-h3" style="color:var(--text-primary)">Market Challenges We Plan Around</h3>
          <p style="margin-top:var(--space-2);color:var(--text-secondary);font-size:var(--text-body-sm)">
            {meta.challenges || 'Tight access windows, zero public disruption, historical site clearances, and rapid turnarounds.'}
          </p>

          <h3 class="epi-h3" style="color:var(--text-primary);margin-top:var(--space-4)">The EPI Solution</h3>
          <p style="margin-top:var(--space-2);color:var(--text-secondary);font-size:var(--text-body-sm)">
            {meta.solutions || 'In-house production in Gaithersburg allows same-day color modifications, precision fabrication, and night install teams.'}
          </p>
        </div>

        <dl class="sig-facts" style="margin-top:var(--space-5)">
          <div>
            <dt>Sector</dt>
            <dd>{title}</dd>
          </div>
          <div>
            <dt>Access window</dt>
            <dd>{meta.access_window || 'Flexible / Scheduled'}</dd>
          </div>
          <div>
            <dt>Turnaround</dt>
            <dd>On-schedule</dd>
          </div>
        </dl>
      </div>
      <figure class="sig-frame">
        <img src={leadImg} alt={title} style="width:100%;height:100%;object-fit:cover;display:block;border-radius:var(--radius-md)" />
      </figure>
    </div>
  </section>

  <!-- Related Work in this Market -->
  {relatedProjects.length > 0 && (
    <section class="sig-section sig-section--warm" aria-labelledby="market-projects-title">
      <div class="epi-container">
        <div class="sig-head">
          <h2 class="epi-h1" id="market-projects-title">Recent projects in {title}</h2>
          <p>Delivered on schedule and on budget across the DMV.</p>
        </div>

        <div class="prj-grid" style="margin-top:clamp(1.5rem,3vw,2.5rem)">
          {relatedProjects.map((p) => (
            <article class="prj-card">
              <figure class="prj-card__media">
                <img
                  src={p.meta_box.lead_image || p.featured_media_url || '/parking-notice-sign-mu13jclv-qgtf.jpg'}
                  alt={typeof p.title === 'string' ? p.title : p.title.rendered}
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:16/10"
                />
              </figure>
              <div class="prj-card__body">
                <h3>
                  <a href={`/projects/${p.slug}`}>
                    {typeof p.title === 'string' ? p.title : p.title.rendered}
                  </a>
                </h3>
                <p>{p.meta_box.summary}</p>
                <ul class="prj-card__tags">
                  <li>{p.meta_box.service_category || 'Custom Work'}</li>
                  <li>{p.meta_box.location || 'DMV'}</li>
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactForm heading={`Consult Us About a ${title} Project`} />
</BaseLayout>
