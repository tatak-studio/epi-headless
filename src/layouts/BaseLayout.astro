---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SEOMetadata } from '../types/wordpress';
import '../styles/design-system/styles.css';
import '../styles/signage-solutions.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  seo?: Partial<SEOMetadata>;
}

const {
  title,
  description = "Improve brand visibility and impact with the top-tier graphics & printing solutions of EPI-Colorspace: design, large format print, fabrication and installation across the DMV.",
  canonical,
  seo,
} = Astro.props;

const pageTitle = seo?.title || title || "We Bring Visions to Life | EPI-Colorspace";
const siteTitle = pageTitle.includes('EPI-Colorspace') ? pageTitle : `${pageTitle} | EPI-Colorspace`;
const metaDesc = seo?.description || description;
const canonicalUrl = seo?.canonical || canonical;
const robotsDirective = seo?.robots ? `${seo.robots.index}, ${seo.robots.follow}` : 'index, follow';

const ogTitle = seo?.open_graph?.title || siteTitle;
const ogDesc = seo?.open_graph?.description || metaDesc;
const ogImage = seo?.open_graph?.image || '/assets/epi-colorspace-logo.png';
const ogType = seo?.open_graph?.type || 'website';
const ogSiteName = seo?.open_graph?.site_name || 'EPI-Colorspace';

const twCard = seo?.twitter?.card || 'summary_large_image';
const twTitle = seo?.twitter?.title || ogTitle;
const twDesc = seo?.twitter?.description || ogDesc;
const twImage = seo?.twitter?.image || ogImage;

const schemaJson = seo?.schema ? JSON.stringify(seo.schema) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content={robotsDirective} />
    <link rel="icon" type="image/png" href="/assets/epi-colorspace-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- OpenGraph Meta -->
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={ogImage} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content={twCard} />
    <meta name="twitter:title" content={twTitle} />
    <meta name="twitter:description" content={twDesc} />
    <meta name="twitter:image" content={twImage} />

    <!-- Structured Data (JSON-LD) -->
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Global shell behavior: header, menus, drawer, reveals, tabs, filters, accordions, project form
      (function () {
        // Scrolled header state
        var header = document.querySelector('.sig-header');
        if (header) {
          var onScroll = function () {
            header.classList.toggle('sig-header--scrolled', window.scrollY > 8);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        // Scroll reveals (shared targets plus page-specific sections)
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var revealTargets = document.querySelectorAll(
          '.sig-head, .sig-split__copy, .sig-frame, .sig-card, .sig-shot, .sig-stats > div, ' +
          '.home-svc__item, .home-caps > article, .home-markets__list > li, .home-logos > li, ' +
          '.sig-acc, .sig-quote, .home-tst, .sig-form, ' +
          '.corp-row, .corp-material, .corp-framing__list li, .corp-band figure, ' +
          '.cre-life > li, .cre-type, .cre-sla > div, ' +
          '.lfp-product, .lfp-tablewrap, .lfp-steps > li, .lfp-band figure, ' +
          '.trade-cycle > li, .trade-scale, .trade-checks li, .trade-logistics__list > li, ' +
          '.exh-feature__media, .exh-feature__card, .exh-element, .exh-care > article, ' +
          '.env-zone, .env-steps > li, .env-impact__list li, .env-band figure'
        );
        if (!reduce.matches && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
          revealTargets.forEach(function (el) { el.classList.add('sig-reveal'); io.observe(el); });
        }

        // Phase tabs
        document.querySelectorAll('.sig-tabs[role="tablist"]').forEach(function (tablist) {
          var tabs = Array.prototype.slice.call(tablist.querySelectorAll('[role="tab"]'));
          var selectTab = function (tab, focus) {
            tabs.forEach(function (t) {
              var on = t === tab;
              t.setAttribute('aria-selected', String(on));
              t.tabIndex = on ? 0 : -1;
              var panel = document.getElementById(t.getAttribute('aria-controls'));
              if (panel) panel.hidden = !on;
            });
            if (focus) tab.focus();
          };
          tabs.forEach(function (tab) {
            tab.addEventListener('click', function () { selectTab(tab, false); });
          });
          tablist.addEventListener('keydown', function (e) {
            var i = tabs.indexOf(document.activeElement);
            if (i < 0) return;
            var next = null;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
            if (e.key === 'Home') next = tabs[0];
            if (e.key === 'End') next = tabs[tabs.length - 1];
            if (next) { e.preventDefault(); selectTab(next, true); }
          });
        });

        // Project gallery filter
        var filters = Array.prototype.slice.call(document.querySelectorAll('.sig-filter'));
        var shots = Array.prototype.slice.call(document.querySelectorAll('.sig-shot'));
        var galleryEmpty = document.getElementById('gallery-empty');
        filters.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var key = btn.dataset.filter;
            filters.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
            var shown = 0;
            shots.forEach(function (shot) {
              var match = key === 'all' || shot.dataset.category === key;
              shot.hidden = !match;
              if (match) shown++;
            });
            if (galleryEmpty) galleryEmpty.hidden = shown > 0;
          });
        });

        // Specs accordion
        document.querySelectorAll('.sig-acc__trigger').forEach(function (trigger) {
          trigger.addEventListener('click', function () {
            var open = trigger.getAttribute('aria-expanded') === 'true';
            trigger.setAttribute('aria-expanded', String(!open));
            var panel = document.getElementById(trigger.getAttribute('aria-controls'));
            if (panel) panel.hidden = open;
          });
        });

        // Header menus (mega panels)
        var menus = Array.prototype.slice.call(document.querySelectorAll('[data-menu-trigger]')).map(function (trigger) {
          return { trigger: trigger, panel: document.getElementById(trigger.getAttribute('aria-controls')) };
        }).filter(function (m) { return m.panel; });

        if (menus.length) {
          var menuTimer = null;
          var desktop = window.matchMedia('(min-width: 1024px)');

          var setMenu = function (menu, open) {
            window.clearTimeout(menuTimer);
            menus.forEach(function (m) {
              var on = m === menu && open;
              m.panel.hidden = !on;
              m.trigger.setAttribute('aria-expanded', String(on));
            });
          };
          var closeMenus = function () { setMenu(null, false); };

          menus.forEach(function (menu) {
            menu.trigger.addEventListener('click', function () { setMenu(menu, menu.panel.hidden); });
            menu.trigger.addEventListener('mouseenter', function () { if (desktop.matches) setMenu(menu, true); });
            menu.panel.addEventListener('click', function (e) { if (e.target.closest('a')) closeMenus(); });
          });

          var headerElem = document.querySelector('.sig-header');
          if (headerElem) {
            headerElem.addEventListener('mouseleave', function () { menuTimer = window.setTimeout(closeMenus, 200); });
            headerElem.addEventListener('mouseenter', function () { window.clearTimeout(menuTimer); });
          }

          var inMenus = function (node) {
            return menus.some(function (m) { return m.panel.contains(node) || m.trigger.contains(node); });
          };
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var open = menus.filter(function (m) { return !m.panel.hidden; })[0];
            if (open) { closeMenus(); open.trigger.focus(); }
          });
          document.addEventListener('focusin', function (e) { if (!inMenus(e.target)) closeMenus(); });
          document.addEventListener('click', function (e) { if (!inMenus(e.target)) closeMenus(); });
        }

        // Mobile drawer
        var burger = document.getElementById('burger');
        var drawer = document.getElementById('drawer');
        var drawerClose = document.getElementById('drawer-close');

        function setDrawer(open) {
          if (!drawer || !burger) return;
          drawer.hidden = !open;
          burger.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
          if (open) {
            var first = drawer.querySelector('a, button');
            if (first) first.focus();
          } else {
            burger.focus();
          }
        }

        if (burger && drawer) {
          burger.addEventListener('click', function () { setDrawer(drawer.hidden); });
          if (drawerClose) drawerClose.addEventListener('click', function () { setDrawer(false); });
          drawer.addEventListener('click', function (e) {
            if (e.target.closest('a')) setDrawer(false);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !drawer.hidden) setDrawer(false);
          });
          var wide = window.matchMedia('(min-width: 1024px)');
          wide.addEventListener('change', function (e) { if (e.matches && !drawer.hidden) setDrawer(false); });
        }

        // Contact form handling
        var form = document.getElementById('project-form');
        var status = document.getElementById('form-status');
        if (form && status) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var missing = Array.prototype.slice.call(form.querySelectorAll('[required]')).filter(function (f) {
              return !f.value.trim();
            });
            missing.forEach(function (f) { f.setAttribute('aria-invalid', 'true'); });
            if (missing.length) {
              status.hidden = false;
              status.style.color = 'var(--status-danger-fg)';
              status.style.background = 'var(--status-danger-bg)';
              status.textContent = 'Add your name, email and a short scope so we can route the request.';
              missing[0].focus();
              return;
            }
            form.querySelectorAll('[aria-invalid]').forEach(function (f) { f.removeAttribute('aria-invalid'); });
            status.hidden = false;
            status.style.color = 'var(--status-success-fg)';
            status.style.background = 'var(--status-success-bg)';
            status.textContent = 'Request received. A project manager replies within one business day.';
            form.reset();
          });

          form.addEventListener('input', function (e) {
            if (e.target.value.trim()) e.target.removeAttribute('aria-invalid');
          });
        }
      })();
    </script>
  </body>
</html>
