---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyGallery from '../../components/CaseStudyGallery.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getProjects, getProjectBySlug } from '../../lib/wordpress';
import type { Project } from '../../types/wordpress';
import '../../styles/project-template.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { slug } = Astro.params;
const { project: initialProject } = Astro.props;
const project = (slug ? await getProjectBySlug(slug) : null) || initialProject;

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const titleOf = (p: Project) => (typeof p.title === 'string' ? p.title : p.title.rendered);
const tokens = (value?: string) => (value || '').split(/\s+/).filter(Boolean);
const toSlug = (value: string) => value.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// Plain-text bodies from the CMS still need paragraph markup for the .cs-body styles.
const asHtml = (body?: string) => (body && !body.trim().startsWith('<') ? `<p>${body}</p>` : body);

const title = titleOf(project);
const meta = project.meta_box || {};
const leadImg = meta.lead_image || project.featured_media_url || '/parking-notice-sign-mu13jclv-qgtf.jpg';

const sections = [
  { heading: meta.section_1_heading || 'What the building needed', body: asHtml(meta.section_1_body), field: 'section_1' },
  { heading: meta.section_2_heading || 'What we produced and installed', body: asHtml(meta.section_2_body), field: 'section_2' },
  { heading: meta.section_3_heading || 'Field conditions we worked around', body: asHtml(meta.section_3_body), field: 'section_3' },
];
const result = { heading: meta.section_4_heading || 'The result', body: asHtml(meta.section_4_body) };
const highlights = meta.highlights || [];
const outcomeStats = meta.outcome_stats || [];
const galleryImages = meta.gallery_images && meta.gallery_images.length > 0
  ? meta.gallery_images
  : [{ url: String(leadImg), caption: title }];

// Related work: explicit CMS entries when present, otherwise the closest matches by market and service.
const allProjects = await getProjects();
const explicitRelated = (meta.related_projects || []).filter((item) => typeof item === 'object' && item?.slug);
const related = explicitRelated.length > 0
  ? explicitRelated
  : allProjects
      .filter((p) => p.slug !== project.slug)
      .map((p) => {
        const m = p.meta_box || {};
        const sharedMarket = tokens(m.filter_market).filter((t) => tokens(meta.filter_market).includes(t)).length;
        const sharedService = tokens(m.filter_services).filter((t) => tokens(meta.filter_services).includes(t)).length;
        return { p, score: sharedMarket * 2 + sharedService };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
      .map(({ p }) => ({
        slug: p.slug,
        title: titleOf(p),
        subtitle: p.meta_box?.scope || (p.meta_box?.card_tags || []).slice(-1)[0] || '',
        image: String(p.meta_box?.lead_image || p.featured_media_url || ''),
      }));
const relatedIntro = meta.related_intro
  || `More work in ${[meta.market, meta.service_line].filter(Boolean).join(' and ').toLowerCase() || 'signage and environmental graphics'}.`;

const index = allProjects.findIndex((p) => p.slug === project.slug);
const prevProject = index > 0 ? allProjects[index - 1] : null;
const nextProject = index >= 0 && index < allProjects.length - 1 ? allProjects[index + 1] : null;
---

<BaseLayout seo={project.seo}>
  <article>
    <header class="cs-hero">
      <div class="epi-container cs-hero__inner">
        <nav aria-label="Breadcrumb">
          <ol class="sig-crumbs">
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/projects">Projects</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        {meta.service_category && <p class="cs-hero__badge" data-field="service_category">{meta.service_category}</p>}
        <h1 id="cs-title" data-field="title">{title}</h1>
        {meta.byline && <p class="cs-hero__byline" data-field="byline">{meta.byline}</p>}
        {meta.summary && <p class="cs-hero__lede" data-field="summary">{meta.summary}</p>}
      </div>
    </header>

    <div class="cs-lead">
      <img src={leadImg} alt={title} style="width:100%;height:100%;object-fit:cover;display:block" />
    </div>

    <section class="sig-section" aria-labelledby="story-title">
      <div class="epi-container cs-layout">
        <div class="cs-body">
          {sections.filter((s) => s.body).map((s, i) => (
            <Fragment>
              <h2 class="epi-h2" id={i === 0 ? 'story-title' : undefined} data-field={`${s.field}_heading`}>{s.heading}</h2>
              <Fragment set:html={s.body} />
            </Fragment>
          ))}
          {!sections.some((s) => s.body) && <h2 class="epi-h2" id="story-title">Project overview</h2>}

          {highlights.length > 0 && (
            <Fragment>
              <h2 class="epi-h2" data-field="highlights_heading">{meta.highlights_heading || 'Project highlights'}</h2>
              <ul class="cs-highlights" data-field="highlights">
                {highlights.map((h) => <li>{h}</li>)}
              </ul>
            </Fragment>
          )}

          {result.body && (
            <Fragment>
              <h2 class="epi-h2" data-field="section_4_heading">{result.heading}</h2>
              <Fragment set:html={result.body} />
            </Fragment>
          )}
        </div>

        <aside class="cs-facts" aria-label="Project details">
          <div class="cs-facts__rule" aria-hidden="true"></div>
          <dl>
            {meta.client && (
              <div>
                <dt>Client</dt>
                <dd data-field="client">{meta.client}</dd>
              </div>
            )}
            {meta.location && (
              <div>
                <dt>Location</dt>
                <dd data-field="location">{meta.location}</dd>
              </div>
            )}
            {meta.scope && (
              <div>
                <dt>Scope</dt>
                <dd data-field="scope">{meta.scope}</dd>
              </div>
            )}
            {meta.service_line && (
              <div>
                <dt>Service line</dt>
                <dd data-field="service_line"><a href={`/services/${toSlug(meta.service_line)}`}>{meta.service_line}</a></dd>
              </div>
            )}
            {meta.market && (
              <div>
                <dt>Market</dt>
                <dd data-field="market"><a href={`/markets/${toSlug(meta.market)}`}>{meta.market}</a></dd>
              </div>
            )}
            {meta.materials && (
              <div>
                <dt>Materials</dt>
                <dd data-field="materials"><span class="epi-mono">{meta.materials}</span></dd>
              </div>
            )}
            {meta.completed && (
              <div>
                <dt>Completed</dt>
                <dd data-field="completed">{meta.completed}</dd>
              </div>
            )}
          </dl>
          <div class="cs-facts__actions">
            <a class="epi-btn" href="#contact">Start Your Project</a>
            <a class="epi-btn epi-btn--secondary" href="tel:3019902666">Call Us Today</a>
          </div>
        </aside>
      </div>
    </section>

    {outcomeStats.length > 0 && (
      <section class="sig-section sig-section--ink" aria-labelledby="outcome-title">
        <div class="epi-container">
          <div class="sig-head">
            <h2 class="epi-h1" id="outcome-title" data-field="outcome_heading">{meta.outcome_heading || 'Measured on site, not on the proof.'}</h2>
          </div>
          <div class="cs-outcome" style="margin-top:clamp(1.5rem,3vw,2.5rem)" data-field="outcome_stats">
            {outcomeStats.map((stat) => (
              <div>
                <p class="cs-outcome__value">{stat.value}</p>
                <p class="cs-outcome__label">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <CaseStudyGallery heading={meta.gallery_heading || 'Installed work'} images={galleryImages} />

    {meta.testimonial_quote && (
      <section class="sig-section sig-section--warm" aria-label="Client feedback">
        <div class="epi-container">
          <figure class="sig-quote">
            <div class="sig-quote__mark" aria-hidden="true"></div>
            <blockquote data-field="testimonial_quote">{meta.testimonial_quote}</blockquote>
            {meta.testimonial_source && <figcaption data-field="testimonial_source">{meta.testimonial_source}</figcaption>}
          </figure>
        </div>
      </section>
    )}

    <section class="sig-section" aria-labelledby="related-title">
      <div class="epi-container">
        <div class="sig-head">
          <h2 class="epi-h1" id="related-title">Related projects</h2>
          <p>{relatedIntro}</p>
        </div>
        {related.length > 0 && (
          <div class="cs-related" data-field="related_projects">
            {related.map((item) => (
              <article>
                <div class="cs-related__frame">
                  <img src={item.image} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>
                <div class="cs-related__body">
                  <h3><a href={`/projects/${item.slug}`}>{item.title}</a></h3>
                  <p>{item.subtitle}</p>
                </div>
              </article>
            ))}
          </div>
        )}
        <nav class="cs-pager" aria-label="Project navigation">
          <a href={prevProject ? `/projects/${prevProject.slug}` : '/projects'}>Previous project</a>
          <a href="/projects">All projects</a>
          <a href={nextProject ? `/projects/${nextProject.slug}` : '/projects'}>Next project</a>
        </nav>
      </div>
    </section>

    <ContactForm />
  </article>

  <!-- Gallery lightbox -->
  <script is:inline>
    (function () {
      var dialog = document.getElementById('cs-lightbox');
      if (!dialog || typeof dialog.showModal !== 'function') return;

      var img = document.getElementById('cs-lightbox-img');
      var note = document.getElementById('cs-lightbox-note');
      var caption = document.getElementById('cs-lightbox-caption');
      var close = document.getElementById('cs-lightbox-close');

      function open(figure) {
        var figureImg = figure.querySelector('img');
        var text = figure.querySelector('figcaption');
        var url = figureImg && figureImg.getAttribute('src');

        caption.textContent = text ? text.textContent : '';
        if (url) {
          img.src = url;
          img.hidden = false;
          note.hidden = true;
        } else {
          img.hidden = true;
          note.hidden = false;
        }
        dialog.showModal();
      }

      document.querySelectorAll('.cs-zoom').forEach(function (btn) {
        btn.addEventListener('click', function () { open(btn.closest('figure')); });
      });

      close.addEventListener('click', function () { dialog.close(); });
      dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
    })();
  </script>
</BaseLayout>
