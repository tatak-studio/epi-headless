---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageBySlug } from '../lib/wordpress';
import '../styles/contact.css';

const contactPage = await getPageBySlug('contact');
const heroHeadline = contactPage?.meta_box?.hero_headline || "We cannot wait to work with you.";
const heroSubhead = contactPage?.meta_box?.hero_subhead || "Whether you are shaping immersive environments, enhancing functionality or telling your brand story, EPI-Colorspace is here to make it unforgettable. Send a scope, a floor plan, a show schedule or a photo of the wall.";
const phone = contactPage?.meta_box?.phone || "301.990.2666";
const phoneHref = `tel:${phone.replace(/[^0-9]/g, '')}`;
const hightailUrl = contactPage?.meta_box?.hightail_url || "https://www.hightail.com/u/epicolorspace";
---

<BaseLayout seo={contactPage?.seo}>
  <section class="sig-section sig-section--ink" aria-labelledby="ct-title">
    <div class="epi-container ct-top">
      <div class="ct-intro">
        <nav aria-label="Breadcrumb">
          <ol class="sig-crumbs">
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Contact Us</li>
          </ol>
        </nav>
        <h1 id="ct-title">{heroHeadline}</h1>
        <p>{heroSubhead}</p>
        <p>One call reaches the people who design, print, build and hang the work. No account layer, no handoff to a subcontractor in the middle of your schedule.</p>
        <dl class="ct-direct">
          <div>
            <dt>Call</dt>
            <dd><a href={phoneHref}>{phone}</a></dd>
            <small>Monday to Friday, 8:30am to 5:00pm Eastern</small>
          </div>
          <div>
            <dt>Visit the shop</dt>
            <dd>8435 Helgerman Ct</dd>
            <small>Gaithersburg, MD 20877. Serving DC, Maryland and Virginia.</small>
          </div>
          <div>
            <dt>Send large files</dt>
            <dd><a href={hightailUrl} target="_blank" rel="noopener noreferrer">Send Files</a></dd>
            <small>Artwork too large to email goes through our transfer link.</small>
          </div>
          <div>
            <dt>Connect</dt>
            <dd><a href="https://www.linkedin.com/company/epi-colorspace" target="_blank" rel="noopener noreferrer">Connect With Us</a></dd>
            <small>Project photography and recent installations on LinkedIn.</small>
          </div>
        </dl>
      </div>

      <div class="ct-card">
        <div class="ct-card__rule" aria-hidden="true"></div>
        <div class="ct-card__inner">
          <h2 class="epi-h3">Start Your Project</h2>
          <p>Tell us what needs to be made, where it goes and when it has to be there.</p>
          <form class="ct-form" id="contact-form" novalidate>
            <p class="ct-status" id="contact-status" role="status" hidden></p>
            <div>
              <label for="ct-name">Name</label>
              <input id="ct-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label for="ct-email">Work email</label>
              <input id="ct-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label for="ct-phone">Phone</label>
              <input id="ct-phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div>
              <label for="ct-org">Organization</label>
              <input id="ct-org" name="organization" type="text" autocomplete="organization" />
            </div>
            <div>
              <label for="ct-service">Service</label>
              <select id="ct-service" name="service">
                <option>Tradeshows</option>
                <option>Exhibits and displays</option>
                <option>Signage solutions</option>
                <option>Large format printing</option>
                <option>Corporate branding and environmental graphics</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div>
              <label for="ct-date">Target date</label>
              <input id="ct-date" name="date" type="date" />
            </div>
            <div class="ct-form__full">
              <label for="ct-scope">What are we making, and where does it go?</label>
              <textarea id="ct-scope" name="scope" required></textarea>
            </div>
            <div class="ct-form__full">
              <label class="ct-choice" for="ct-files">
                <input id="ct-files" name="files" type="checkbox" />
                <span>I have artwork or drawings ready to send.</span>
              </label>
            </div>
            <div class="ct-form__full">
              <button class="epi-btn epi-btn--block" type="submit">Start Your Project</button>
              <p class="ct-form__note" style="margin-top:var(--space-3)">We reply within one business day. Urgent install dates are worth a phone call.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="sig-section" aria-labelledby="place-title">
    <div class="epi-container ct-place">
      <div class="sig-split__copy">
        <h2 class="epi-h1" id="place-title">One shop in Gaithersburg, work across the DMV.</h2>
        <p>Design, large format print, fabrication, crating and installation all happen in the same building. You are welcome to come see a proof on the substrate before it goes into production.</p>
        <dl class="ct-hours">
          <div>
            <dt>Monday to Friday</dt>
            <dd>8:30am to 5:00pm</dd>
          </div>
          <div>
            <dt>Saturday and Sunday</dt>
            <dd>Install crews by schedule</dd>
          </div>
          <div>
            <dt>Shop visits</dt>
            <dd>By appointment</dd>
          </div>
          <div>
            <dt>Deliveries</dt>
            <dd>Rear dock, weekdays</dd>
          </div>
        </dl>
        <p style="margin-top:var(--space-5)"><a class="epi-btn epi-btn--secondary" href="https://maps.google.com/?q=8435+Helgerman+Ct+Gaithersburg+MD+20877" target="_blank" rel="noopener noreferrer">Get directions</a></p>
      </div>
      <figure class="ct-place__media" style="min-height:420px">
        <iframe
          title="Map of EPI-Colorspace, 8435 Helgerman Ct, Gaithersburg, MD 20877"
          src="https://www.google.com/maps?q=8435+Helgerman+Ct,+Gaithersburg,+MD+20877&output=embed"
          style="width:100%;height:100%;min-height:420px;border:0;display:block;border-radius:8px"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </figure>
    </div>
  </section>

  <section class="sig-section sig-section--warm" aria-labelledby="routes-title">
    <div class="epi-container">
      <div class="sig-head">
        <h2 class="epi-h1" id="routes-title">Not sure who you need?</h2>
        <p>Start here and we will put the right person on it.</p>
      </div>
      <div class="ct-routes">
        <article class="ct-route">
          <h3>New project or estimate</h3>
          <p>Send a scope and a date. If you have drawings or a sign schedule, price comes back to the piece rather than to an allowance.</p>
          <a href="#contact-form">Use the form</a>
        </article>
        <article class="ct-route">
          <h3>Reprint or repair</h3>
          <p>We keep your artwork, sign schedule and hardware specs on file, so a damaged panel is usually a reprint and a service call.</p>
          <a href={phoneHref}>Call {phone}</a>
        </article>
        <article class="ct-route">
          <h3>Tradeshow logistics</h3>
          <p>Show dates, drayage deadlines and stored properties. Booth programs live with our tradeshow team year round.</p>
          <a href="/services/tradeshows">Tradeshow services</a>
        </article>
        <article class="ct-route">
          <h3>Sending artwork</h3>
          <p>Vector files in <span class="epi-mono">.ai</span>, <span class="epi-mono">.eps</span> or <span class="epi-mono">.pdf</span>, raster art at final size with <span class="epi-mono">0.125 in</span> bleed.</p>
          <a href={hightailUrl} target="_blank" rel="noopener noreferrer">Send Files</a>
        </article>
      </div>
    </div>
  </section>

  <section class="sig-section" aria-label="Client feedback">
    <div class="epi-container">
      <figure class="sig-quote">
        <div class="sig-quote__mark" aria-hidden="true"></div>
        <blockquote>So much is thrown at me during final preparations that major balls start dropping. I am glad I can count on you and your team.</blockquote>
        <figcaption>Tradeshow manager, medical technology company</figcaption>
      </figure>
    </div>
  </section>

  <!-- Contact form validation and confirmation -->
  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;

      var status = document.getElementById('contact-status');
      var emailField = document.getElementById('ct-email');

      function show(kind, message) {
        status.hidden = false;
        status.textContent = message;
        if (kind === 'error') {
          status.style.color = 'var(--status-danger-fg)';
          status.style.background = 'var(--status-danger-bg)';
        } else {
          status.style.color = 'var(--status-success-fg)';
          status.style.background = 'var(--status-success-bg)';
        }
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var required = Array.prototype.slice.call(form.querySelectorAll('[required]'));
        var missing = required.filter(function (f) { return !f.value.trim(); });
        var badEmail = emailField.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailField.value.trim());

        missing.forEach(function (f) { f.setAttribute('aria-invalid', 'true'); });
        if (badEmail) emailField.setAttribute('aria-invalid', 'true');

        if (missing.length) {
          show('error', 'Add your name, email and a short description so we can route the request.');
          missing[0].focus();
          return;
        }
        if (badEmail) {
          show('error', 'That email address looks incomplete. Check it and send again.');
          emailField.focus();
          return;
        }

        form.querySelectorAll('[aria-invalid]').forEach(function (f) { f.removeAttribute('aria-invalid'); });
        show('ok', 'Request received. A project manager replies within one business day, sooner if you gave us a date.');
        form.reset();
      });

      form.addEventListener('input', function (e) {
        if (e.target.value.trim()) e.target.removeAttribute('aria-invalid');
      });
    })();
  </script>
</BaseLayout>
