---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServices, getServiceBySlug } from '../../lib/wordpress';
import TradeshowsContent from '../../components/services/TradeshowsContent.astro';
import SignageSolutionsContent from '../../components/services/SignageSolutionsContent.astro';
import LargeFormatPrintingContent from '../../components/services/LargeFormatPrintingContent.astro';
import CorporateBrandingContent from '../../components/services/CorporateBrandingContent.astro';
import ExhibitsAndDisplaysContent from '../../components/services/ExhibitsAndDisplaysContent.astro';
import EnvironmentalGraphicsContent from '../../components/services/EnvironmentalGraphicsContent.astro';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { slug } = Astro.params;
const { service: initialService } = Astro.props;
const service = (slug ? await getServiceBySlug(slug) : null) || initialService;

if (!service) {
  throw new Error(`Service not found: ${slug}`);
}
---

<BaseLayout seo={service.seo}>
  {slug === 'tradeshows' && <TradeshowsContent service={service} />}
  {slug === 'signage-solutions' && <SignageSolutionsContent service={service} />}
  {slug === 'large-format-printing' && <LargeFormatPrintingContent service={service} />}
  {slug === 'corporate-branding' && <CorporateBrandingContent service={service} />}
  {slug === 'exhibits-and-displays' && <ExhibitsAndDisplaysContent service={service} />}
  {slug === 'environmental-graphics' && <EnvironmentalGraphicsContent service={service} />}
</BaseLayout>
