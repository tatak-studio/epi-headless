---
import type { GalleryImage } from '../types/wordpress';

interface Props {
  heading?: string;
  images: GalleryImage[];
}
const { heading = 'Installed work', images } = Astro.props;
---

<section class="sig-section" aria-labelledby="gallery-title">
  <div class="epi-container">
    <div class="sig-head">
      <h2 class="epi-h1" id="gallery-title" data-field="gallery_heading">{heading}</h2>
      <p>Select any frame to see it larger.</p>
    </div>
    <div class="cs-gallery">
      {images.map((img) => (
        <figure>
          <div class="cs-gallery__frame">
            <img src={img.url} alt={img.alt || img.caption || ''} loading="lazy" decoding="async" />
          </div>
          <button class="cs-zoom" type="button">Enlarge</button>
          {img.caption && <figcaption data-field="gallery_caption">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog class="cs-lightbox" id="cs-lightbox" aria-label="Project image">
  <img id="cs-lightbox-img" alt="" hidden />
  <p class="cs-lightbox__empty" id="cs-lightbox-note" hidden>This frame is still empty. Drop an image on it in the gallery to view it here.</p>
  <div class="cs-lightbox__bar">
    <p class="cs-lightbox__caption" id="cs-lightbox-caption"></p>
    <button class="epi-btn epi-btn--sm epi-btn--inverse cs-lightbox__close" type="button" id="cs-lightbox-close">Close</button>
  </div>
</dialog>

<style>
  .cs-gallery__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }
</style>
