---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getServices, getServiceBySlug, getProjects } from '../../lib/wordpress';
import '../../styles/tradeshows.css';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { slug } = Astro.params;
const { service: initialService } = Astro.props;
const service = (slug ? await getServiceBySlug(slug) : null) || initialService;

if (!service) {
  throw new Error(`Service not found: ${slug}`);
}

const title = typeof service.title === 'string' ? service.title : service.title.rendered;
const meta = service.meta_box || {};
const leadImg = meta.lead_image || '/trade-show-printer-mu13gi32-4z7q.jpg';

const allProjects = await getProjects();
// Filter related projects by service category
const relatedProjects = allProjects.filter((p) => {
  const cat = (p.meta_box.service_category || '').toLowerCase();
  const filterKey = (p.meta_box.filter_services || '').toLowerCase();
  const slugKey = service.slug.toLowerCase();
  return cat.includes(slugKey.substring(0, 5)) || filterKey.includes(slugKey.substring(0, 5));
}).slice(0, 3);
---

<BaseLayout seo={service.seo}>
  <!-- Hero -->
  <section class="sig-hero" aria-labelledby="hero-title">
    <div class="sig-hero__media">
      <img src={leadImg} alt={title} style="width:100%;height:100%;object-fit:cover;display:block" />
    </div>
    <div class="sig-hero__scrim" aria-hidden="true"></div>
    <div class="epi-container sig-hero__inner">
      <nav aria-label="Breadcrumb">
        <ol class="sig-crumbs">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/services">Services</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      {meta.kicker && <p class="sig-kicker">{meta.kicker}</p>}
      <h1 class="epi-display-2 sig-hero__title" id="hero-title">
        {title} designed, built, and installed by one in-house team.
      </h1>
      <p class="sig-hero__lede">{meta.summary}</p>
      <div class="sig-hero__actions">
        <a class="epi-btn epi-btn--lg" href="#start">Start Your Project</a>
        <a class="epi-btn epi-btn--lg epi-btn--outline-inverse" href="/projects">See our Projects</a>
      </div>
    </div>
    <div class="sig-hero__rule" aria-hidden="true"></div>
  </section>

  <!-- Split Intro -->
  <section class="sig-section" aria-labelledby="intro-title">
    <div class="epi-container sig-split">
      <div class="sig-split__copy">
        <h2 class="epi-h1" id="intro-title">
          For over 20 years, EPI-Colorspace has been a trusted partner across the DMV.
        </h2>
        <p>
          We specialize in transforming a wide variety of spaces into immersive brand environments. Every graphic is printed in our own shop in Gaithersburg, every piece is inspected before shipping, and our own team is on site to install it.
        </p>
        {meta.turnkey_scope && (
          <p style="padding:var(--space-4);background:var(--paper-warm);border-left:4px solid var(--surface-brand);font-size:var(--text-body-sm)">
            <strong>Turnkey scope:</strong> {meta.turnkey_scope}
          </p>
        )}
        <dl class="sig-facts">
          <div>
            <dt>Production</dt>
            <dd>100% in-house</dd>
          </div>
          <div>
            <dt>Coverage</dt>
            <dd>DC, MD, VA</dd>
          </div>
          <div>
            <dt>Install team</dt>
            <dd>Certified crew</dd>
          </div>
        </dl>
      </div>
      <figure class="sig-frame">
        <img src={leadImg} alt={title} style="width:100%;height:100%;object-fit:cover;display:block;border-radius:var(--radius-md)" />
      </figure>
    </div>
  </section>

  <!-- Capabilities and Deliverables Grid -->
  <section class="sig-section sig-section--warm" aria-labelledby="scope-title">
    <div class="epi-container">
      <div class="sig-head">
        <h2 class="epi-h1" id="scope-title">Capabilities &amp; Deliverables</h2>
        <p>From initial design specifications to final field installation.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 340px), 1fr));gap:var(--space-6);margin-top:clamp(2rem,4vw,3rem)">
        <!-- Capabilities -->
        <div style="background:var(--paper);padding:var(--space-6);border:1px solid var(--border-subtle);border-top:3px solid var(--ink-950)">
          <h3 class="epi-h3">Core Capabilities</h3>
          <ul class="cs-highlights" style="margin-top:var(--space-4)">
            {(meta.capabilities || [
              'Custom engineering & 3D rendering',
              'Direct UV flatbed printing',
              'High-precision CNC routing and finishing',
              'On-site field rigging & installation',
            ]).map((cap) => (
              <li>{cap}</li>
            ))}
          </ul>
        </div>

        <!-- Deliverables -->
        <div style="background:var(--paper);padding:var(--space-6);border:1px solid var(--border-subtle);border-top:3px solid var(--surface-brand)">
          <h3 class="epi-h3">What We Deliver</h3>
          <ul class="cs-highlights" style="margin-top:var(--space-4)">
            {(meta.deliverables || [
              'Full environmental graphics installations',
              'Custom fabricated architectural signs',
              'Overhead structural banners & displays',
              'Wayfinding & message schedules',
            ]).map((del) => (
              <li>{del}</li>
            ))}
          </ul>
        </div>

        <!-- Materials -->
        <div style="background:var(--paper);padding:var(--space-6);border:1px solid var(--border-subtle);border-top:3px solid var(--ink-950)">
          <h3 class="epi-h3">Materials &amp; Substrates</h3>
          <ul class="cs-highlights" style="margin-top:var(--space-4)">
            {(meta.materials_used || [
              'Heavy-gauge aluminum and Corten steel',
              'Duratex blockout PET/PVC films',
              'Dye-sublimation tension fabrics',
              'High-conformability architectural vinyls',
            ]).map((mat) => (
              <li>{mat}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Projects Section -->
  {relatedProjects.length > 0 && (
    <section class="sig-section" aria-labelledby="rel-title">
      <div class="epi-container">
        <div class="sig-head">
          <h2 class="epi-h1" id="rel-title">Installed work in {title}</h2>
          <p>Recent projects designed, printed, fabricated and installed by our team.</p>
        </div>
        <div class="prj-grid" style="margin-top:clamp(1.5rem,3vw,2.5rem)">
          {relatedProjects.map((p) => (
            <article class="prj-card">
              <figure class="prj-card__media">
                <img
                  src={p.meta_box.lead_image || p.featured_media_url || '/parking-notice-sign-mu13jclv-qgtf.jpg'}
                  alt={typeof p.title === 'string' ? p.title : p.title.rendered}
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:16/10"
                />
              </figure>
              <div class="prj-card__body">
                <h3>
                  <a href={`/projects/${p.slug}`}>
                    {typeof p.title === 'string' ? p.title : p.title.rendered}
                  </a>
                </h3>
                <p>{p.meta_box.summary}</p>
                <ul class="prj-card__tags">
                  <li>{p.meta_box.service_category || title}</li>
                  <li>{p.meta_box.location || 'DMV'}</li>
                </ul>
              </div>
            </article>
          ))}
        </div>
        <p style="margin-top:var(--space-6);text-align:center">
          <a class="epi-btn epi-btn--secondary" href="/projects">View all Projects</a>
        </p>
      </div>
    </section>
  )}

  <div id="start">
    <ContactForm heading={`Start Your ${title} Project`} />
  </div>
</BaseLayout>
